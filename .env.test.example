# A dedicated Supabase project used ONLY by the Playwright e2e suite — never the dev/prod project.
# Copy to .env.test (gitignored) and fill in. In CI, these are not used at all — the CI job
# points DATABASE_URL at a Postgres service container instead (see .github/workflows/ci.yml).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/postgres
TEST_SUPABASE_URL=https://your-test-project.supabase.co
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Bootstrapped (created + email-confirmed) by e2e/global-setup.ts via the admin API if missing.
TEST_OPERATOR_EMAIL=e2e-operator@tiffin-test.local
TEST_OPERATOR_PASSWORD=E2eTestPassw0rd!
